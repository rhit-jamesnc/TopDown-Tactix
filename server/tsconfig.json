{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "#shared/*": ["../shared/*"]
    },
    "rootDir": "..", 
    "outDir": "../dist",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "noEmit": true 
  },
  "include": [
    "./src/**/*",
    "../shared/**/*",
    "index.js"
  ],
  "exclude": [
    "node_modules",
    "../dist"
  ]
}